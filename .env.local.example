# =============================================================================
# ResolveHub — environment configuration
# Copy this file to `.env.local` and fill in the values.
# `.env.local` is gitignored and must never be committed.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED — Supabase project URL and public (anon / publishable) key.
# Find both in: Supabase Dashboard → Project Settings → API
#
# The anon key is safe in the browser: Row Level Security decides what any
# given user is allowed to read or write.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# -----------------------------------------------------------------------------
# OPTIONAL — server-only service-role key.
#
# Required only for the administrator's "add staff account" and "delete staff
# account" features, because creating Auth users is a privileged operation.
#
# NEVER prefix this with NEXT_PUBLIC_. It bypasses Row Level Security, and
# `lib/supabase/admin.ts` imports `server-only`, so importing it from a client
# component is a build error.
# -----------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -----------------------------------------------------------------------------
# OPTIONAL — absolute site URL used for email confirmation links.
# Defaults to the request host when omitted. Set this in production, e.g.
# https://resolvehub.yourdomain.com
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
